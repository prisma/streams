# F1a floor (design §9.2): T-launch with KEEP_AWAKE=1, scraped every 20 s.
# T-launch (D2): 4 server ordinals, FLEET_MIN=2 (the ring), FLEET_MAX=4:
# ordinals 3-4 are spares that sleep until the scaler wants them; KEEP_AWAKE
# holds only ordinals 1-2 and the routers. No customer traffic. Request
# cost from /v1/debug/store totals (scraped only while a server is live).
SERVERS=4
FLEET_MIN=2
ROUTERS=2
KEEP_AWAKE=1
KEEP_AWAKE_TTL_MIN=1500        # 25 h: the 24 h floor run plus margin; enforced in-instance
SCRAPE=1
WAL_POSTURE=P-exp
INITIAL_SHARDS=4
