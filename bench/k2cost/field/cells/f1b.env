# F1b floor (design §9.2): T-launch (4 ordinals, FLEET_MIN=2, FLEET_MAX=4),
# KEEP_AWAKE unset, NO scraping of servers or routers while the cell has no
# traffic (a probe would wake them). F2 continues on this cell: its observer
# then runs with --scrape-cell f1b, which scrapes only live servers.
SERVERS=4
FLEET_MIN=2
ROUTERS=2
SCRAPE=0
WAL_POSTURE=P-exp
INITIAL_SHARDS=4
