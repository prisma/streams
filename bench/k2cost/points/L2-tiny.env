# L2 smoke: the shard-count lever (design §9.1 L2) at a tiny scale:
# 20 req/s of 1 KiB x 10 over 8 streams on SHARDS shards for 30 s.
SHARDS=${SHARDS:-4}
WAL_GAP=${WAL_GAP:-100}
POINT_NAME=L2-tiny-s$SHARDS-g$WAL_GAP
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS WAL_FLUSH_GAP_MS=$WAL_GAP"
PHASES="
setup --streams 8 --prefix k2/l2
idle 20
produce --streams 8 --prefix k2/l2 --rate 20 --records 10 --record-bytes 1024 --payload corpus --duration 30 --seed 2
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=0
