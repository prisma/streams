# L7 smoke: lifecycle churn (design §9.1 L7) at a tiny scale: 20 streams
# of 4 KiB each, created, appended, read once and deleted.
POINT_NAME=L7-tiny
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
churn --count 20 --size-kib 4 --end delete --prefix k2/l7 --concurrency 2
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=30
