# L6: fixed costs (design §9.1 L6).
# (a) one server idle 60 min with SHARDS open shards (4, then 16):
#   SHARDS=16 bench/k2cost/run-local.sh bench/k2cost/points/L6-full.env
# (b) the T-launch shape locally, 2 servers + pilot router + rollup + billing:
#   SERVERS=2 bench/k2cost/run-local.sh bench/k2cost/points/L6-full.env
# (c) billing on versus off at 200 req/s, 15 + 15 min (the system-stream
#   share is the difference): ARM=load, then ARM=load BILLING=off
#   (BILLING=off drops USAGE_STREAM_KEY and ROLLUP; revenue is then absent;
#   untested under STREAMS_RELEASE_POSTURE=1).
SERVERS=${SERVERS:-1}
SHARDS=${SHARDS:-4}
ARM=${ARM:-idle}
BILLING=${BILLING:-on}
POINT_NAME=L6-full-$ARM-n$SERVERS-s$SHARDS-billing$BILLING
S3LITE_LATENCY_MS=20
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS"
[ "$BILLING" = off ] && SERVER_ENV_EXTRA="$SERVER_ENV_EXTRA BILLING_MODE=off -USAGE_STREAM_KEY ROLLUP=0"
if [ "$ARM" = load ]; then
  PHASES="
setup --streams 64 --prefix k2/l6
produce --streams 64 --prefix k2/l6 --rate 200 --records 10 --record-bytes 1024 --payload corpus --duration 900 --seed 61
"
else
  PHASES="
setup --streams 64 --prefix k2/l6
produce --streams 64 --prefix k2/l6 --rate 64 --records 1 --record-bytes 1024 --payload corpus --duration 10 --seed 62
idle 3600
"
fi
QUIESCE=0
IDLE_SECS=0
