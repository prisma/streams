# SCR-IDLE: screening point for the idle cell's floor (the `_ops_metrics`
# cadence lever, E9-B1, streams-cost report 2026-10-24 §6 #5) on the launch
# posture: one shared-cell server (compute-1g.env + shared-cell.env: one
# shard, fleet off, an 8 MiB tail ring
# (unset with SERVER_ENV_EXTRA=-TAIL_RING_BYTES), 32/16 MiB caches), s3lite at 20 ms. About
# 23 minutes:
#
#   4 streams, a 30 s burst of 1 KiB JSON singles at 10 req/s (opens the
#   shard, history and telemetry DBs as a tenant's first writes do);
#   120 s to settle (the burst's absorption at the 60 s absorb age and its
#   first compactions);
#   IDLE_MEASURE_SECS (1200) of idle cell: no client traffic, only the
#   floor (the system streams' snapshots, timer L0s, polls, rollup).
#
# Verdict counts (counts.py RUN; a pair: counts.py --compare REF CAND
# --window 'phase 4' --per-hour): the idle window `phase 4` per hour:
# shard/wal/put with pump_flushes, shard/sst/put, shard/manifest/put and
# the telemetry tier, class_a, class_b, put_bytes. SCR_SMOKE=1 shortens it
# to about 4 minutes (a 120 s idle window).
POINT_NAME=SCR-IDLE
POSTURE=launch
S3LITE_LATENCY_MS=20
SERVERS=1
if [ "${SCR_SMOKE:-0}" = 1 ]; then
  POINT_NAME=SCR-IDLE-smoke
  BURST_SECS=10
  SETTLE_SECS=20
  IDLE_MEASURE_SECS=${IDLE_MEASURE_SECS:-120}
  USAGE_WAIT_SECS=120
else
  BURST_SECS=30
  SETTLE_SECS=120
  IDLE_MEASURE_SECS=${IDLE_MEASURE_SECS:-1200}
fi
PHASES="
setup --streams 4 --prefix scr/idle
produce --streams 4 --prefix scr/idle --rate 10 --records 1 --record-bytes 1024 --payload corpus --duration $BURST_SECS --seed 61
idle $SETTLE_SECS
idle $IDLE_MEASURE_SECS
"
QUIESCE=0
IDLE_SECS=0
