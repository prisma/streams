# L3: write path and storage per byte (design §9.1 L3). 1 MB/s of
# plaintext for 20 min over 8 streams, then quiescence (§8). Gives
# immediate and deferred Class A/B per GiB, c, k, a and b from the 10 s
# live_bytes census, and transient peaks. The six points:
#   PAYLOAD=corpus  RECORDS=1  RECORD_BYTES=128
#   PAYLOAD=corpus  RECORDS=10 RECORD_BYTES=1024          (default)
#   PAYLOAD=corpus  RECORDS=64 RECORD_BYTES=16384
#   PAYLOAD=bytes   RECORDS=1  RECORD_BYTES=1024          (bytes streams, singles only)
#   PAYLOAD=b64rand RECORDS=10 RECORD_BYTES=1024
#   PAYLOAD=corpus  RECORDS=10 RECORD_BYTES=1024 WAL_GAP=1000   (P-1000)
PAYLOAD=${PAYLOAD:-corpus}
RECORDS=${RECORDS:-10}
RECORD_BYTES=${RECORD_BYTES:-1024}
WAL_GAP=${WAL_GAP:-100}
FORMAT=json
[ "$PAYLOAD" = bytes ] && FORMAT=bytes
POINT_NAME=L3-full-$PAYLOAD-${RECORD_BYTES}x$RECORDS-g$WAL_GAP
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA="WAL_FLUSH_GAP_MS=$WAL_GAP"
PHASES="
setup --streams 8 --prefix k2/l3 --format $FORMAT
produce --streams 8 --prefix k2/l3 --mbps 1 --records $RECORDS --record-bytes $RECORD_BYTES --payload $PAYLOAD --duration 1200 --seed 3
"
QUIESCE=1
# The idle tail after quiescence (quiesced -> end) is priced as floor and is
# the point's own per-cell baseline; K2_BASELINE=<an L6 idle run> replaces
# it with a 60 min one (design §8).
IDLE_SECS=${IDLE_SECS:-900}
