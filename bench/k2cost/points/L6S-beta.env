# L6 spike Gate S S10: the beta shape (owner call 9 (i), 2026-10-15). Derived
# from bench/k2cost/points/L6S.env at 00d6b7e2. Throwaway: lives on the
# never-merged l6-spike branch.
#
#   spike-run.sh S10 POINT=L6S-beta.env ARM=b
#
# Shape (GATE-S.md S10): 1 shard; 10,000 JSON streams of which a Zipf-skewed
# subset is active (k2gen --zipf; at ZIPF=1.3 and 180 singles/s about 1,200
# distinct streams per minute, inside 200-2,000); 300 B and 1 KiB corpus
# singles (two producers, RATE_300 and RATE_1K req/s) and a few batched writers
# (BSTREAMS streams under their own prefix, corpus 1 KiB x 40 at RATE_BATCH
# req/s in all). About 0.1 MB/s stored in all (0.05-0.2).
#
# Phases (census-beta.py maps them onto census.py's 1-7):
#   1 setup of the singles streams, 2 setup of the batched streams,
#   3 warm-up (300 B singles at 2 req/s, uniform, seed 2: the cold shard's
#   first-touch 503s), 4-6 the load (two background producers and the 300 B
#   foreground producer, LOAD_SECS each), 7-8 the audits, 9 the tail, 10-11
#   the audits again, 12 the floor.
ARM=${ARM:?ARM=base|b}
SHARDS=${SHARDS:-1}
STREAMS=${STREAMS:-10000}
BSTREAMS=${BSTREAMS:-4}
WAL_GAP=${WAL_GAP:-100}
ZIPF=${ZIPF:-1.3}
RATE_300=${RATE_300:-120}
RATE_1K=${RATE_1K:-60}
RATE_BATCH=${RATE_BATCH:-2}
LOAD_SECS=${LOAD_SECS:-1800}
TAIL_SECS=${TAIL_SECS:-1200}
FLOOR_SECS=${FLOOR_SECS:-300}
S3LITE_PUT_BPS=${S3LITE_PUT_BPS:-25000000}
case "$ARM" in
  base) SPILL=0; RING="TAIL_RING_BYTES=0" ;;
  b) SPILL=1; RING="TAIL_RING_BYTES=0 L6_RING_PROCESS_BYTES=${L6_RING_PROCESS_BYTES:-67108864} L6_RING_SHARD_BYTES=${L6_RING_SHARD_BYTES:-8388608}" ;;
  *) echo "L6S-beta.env: ARM must be base or b" >&2; exit 2 ;;
esac
BW_TAG=$([ "$S3LITE_PUT_BPS" = 0 ] && echo -uncapped || echo)
CELL_ROWS=${CELL_ROWS:-0}
if [ "$CELL_ROWS" = 1 ]; then
  CELL_ENV="PROJECT_MEMORY_PRESSURE_BYTES=33554432 PROJECT_SHARE_K=8 MAX_UNABSORBED_BYTES_PER_INSTANCE=536870912"
  CELL_TAG=-sc
else
  CELL_ENV=
  CELL_TAG=
fi
POINT_NAME=${POINT_NAME:-L6S-beta-${L6_LABEL:-$ARM}-z$ZIPF-r${RATE_300}+${RATE_1K}+b${RATE_BATCH}-g$WAL_GAP-s$SHARDS-n$STREAMS$BW_TAG$CELL_TAG}
S3LITE_LATENCY_MS=20
SERVERS=1
# Every customer stream's frame bytes in each scrape line (10,004 streams).
export K2_PER_STREAM_MAX=${K2_PER_STREAM_MAX:-12000}
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS WAL_FLUSH_GAP_MS=$WAL_GAP L6_SPILL=$SPILL ADMIT_RSS_SHED_MB=2000 $RING $CELL_ENV ${L6_EXTRA:-}"
S="--streams $STREAMS --prefix k2/l6s"
B="--streams $BSTREAMS --prefix k2/l6w"
PHASES="
setup $S --format json
setup $B --format json
produce $S --rate 2 --records 1 --record-bytes 300 --payload corpus --duration 30 --seed 2
produce $B --rate $RATE_BATCH --records 40 --record-bytes 1024 --payload corpus --duration $LOAD_SECS --seed 5 &
produce $S --rate $RATE_1K --records 1 --record-bytes 1024 --payload corpus --zipf $ZIPF --duration $LOAD_SECS --seed 4 &
produce $S --rate $RATE_300 --records 1 --record-bytes 300 --payload corpus --zipf $ZIPF --duration $LOAD_SECS --seed 3
audit $S --expect \$RUN/phase-3.ledger.json,\$RUN/phase-5.ledger.json,\$RUN/phase-6.ledger.json --parallel 8
audit $B --expect \$RUN/phase-4.ledger.json --parallel 4
idle $TAIL_SECS
audit $S --expect \$RUN/phase-3.ledger.json,\$RUN/phase-5.ledger.json,\$RUN/phase-6.ledger.json --parallel 8
audit $B --expect \$RUN/phase-4.ledger.json --parallel 4
idle $FLOOR_SECS
"
QUIESCE=0
IDLE_SECS=0
