# P2C-2D: edge change #248's condition 2d on the production shapes (Fable 5.1's
# decision of 2026-11-05, sections 7 and 8): a tiny-stream population, then passes
# of touches, each an append of one 64-byte record and a records read. No usage
# scrape in the loop (the settle poll stays), /v1/debug/timings every 10 s.
# P2C_SHAPE picks:
#   A  the dedicated-cell profile (CONTAINER_SHARE_K=1, a 256 MiB line): 100,000
#      streams, two passes at 300/s
#   B  the shared-cell profile at its documented capacity (tenants/p2c-2d-b.json):
#      8 projects x 8,192 streams, 75 touches/s each, 6 passes
# Both abort at the first refusal: a refused leg measures nothing. P2C_TAIL=1
# runs B with touches reading from each stream's last cursor, not from offset 0.
P2C_SHAPE=${P2C_SHAPE:?set P2C_SHAPE to A or B}
POINT_NAME=P2C-2D-$P2C_SHAPE
POSTURE=launch
SERVERS=1
QUIESCE=0
IDLE_SECS=0
SCRAPE_USAGE_SECS=0
SCRAPE_TIMINGS=1
S3LITE_LATENCY_MS=${S3LITE_LATENCY_MS:-20}
SERVER_ENV_EXTRA="TOKIO_WORKERS=2${SERVER_ENV_EXTRA:+ $SERVER_ENV_EXTRA}"
case $P2C_SHAPE in
  A)
    LAUNCH_PROFILE=dedicated
    N=${P2C_STREAMS:-100000}
    TOUCH="touch --streams $N --prefix p2c/r --rate 300 --passes 1 --concurrency 512 --record-bytes 64 --abort-on-refusal 1"
    PHASES="
setup --streams $N --prefix p2c/r --parallel 64 --abort-on-stream-limit 1
$TOUCH
$TOUCH
" ;;
  B)
    LAUNCH_PROFILE=shared
    TENANTS_MANIFEST=bench/k2cost/tenants/p2c-2d-b${P2C_TAIL:+-tail}.json
    PHASES="tenants" ;;
  *) echo "P2C_SHAPE must be A or B" >&2; exit 2 ;;
esac
