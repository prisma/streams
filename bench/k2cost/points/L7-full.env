# L7: lifecycle churn and reclamation (design §9.1 L7). 10k streams of
# SIZE_KIB in {1, 10, 100}: create, append, read once, delete; then
# quiescence. Live bytes before and after give U(t), which is expected to
# persist. The TTL arm (END=ttl:3600) waits out the expiry with
# IDLE_SECS=3900 after quiescence:
#   SIZE_KIB=100 bench/k2cost/run-local.sh bench/k2cost/points/L7-full.env
#   END=ttl:3600 bench/k2cost/run-local.sh bench/k2cost/points/L7-full.env
SIZE_KIB=${SIZE_KIB:-10}
END=${END:-delete}
POINT_NAME=L7-full-$SIZE_KIB-kib-$(echo "$END" | tr ':' '-')
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
churn --count 10000 --size-kib $SIZE_KIB --end $END --prefix k2/l7 --concurrency 8
"
QUIESCE=1
IDLE_SECS=0
case "$END" in ttl:*) IDLE_SECS=3900 ;; esac
