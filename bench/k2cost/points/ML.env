# ML: Fable's profiles M (medium CDC) and L (large sink) (streams-cost report
# 2026-10-24 §4.1) on the launch posture, measured against their K2 bills
# (layout 6A's last measurement, the lead 2026-11-01). Tenants mode, as
# PACK-S: compute-1g.env + shared-cell.env (one shard, fleet off, k = 8),
# s3lite at 20 ms, TOKIO_WORKERS=2, projects admitted through cell-admin with
# their weights (tenants/ml-*.json). ML_CELL picks the cell:
#   m-shared  M (weights request 2, bytes 6) beside 48 unit S tenants
#   l-shared  L (byte weight 7; at 1.40 req/s, about 80% of its weighted
#             ceiling, which the profile's 1.78 req/s exceeds)
#             beside 48 unit S tenants
#   s-base    the 48 S tenants alone (pack-s-mux-0048): the shared cells'
#             arm A, run the same day, for M's and L's marginal
#   m-alone   M on a dedicated cell, at the profile's 12.1 req/s
#   l-alone   L on a dedicated cell, at the profile's 1.78 req/s: the load,
#             then one walk of everything it wrote (the day's walk)
# cell-admin admits no k = 1 cell ("a shared cell needs k >= 2"), so the
# dedicated cells run k2gen's phases with one project through the platform
# emulator, as SCR-M does: CONTAINER_SHARE_K=1 and the memory line at the
# shard's 256 MiB unabsorbed line give it the whole cell's admission, and
# its records are corpus JSON (c about 4.4; the shared cells' oracle-corpus
# records about 4.9).
# Each record is an oracle-corpus record: corpus JSON inside the oracle's
# fields, so the leak checks hold and the bytes compress as the profiles'
# JSON (c about 4) rather than as the oracle's random base64 (c 1.33).
# About 40 minutes, PACK-S's schedule (verdict window `period steady`,
# 360-1,560 s); ML_SMOKE=1 runs it at time scale 0.15. Priced from each
# run's packing.json terms (the instance's month) by the measurement's own
# script: a shared cell's tenant is its marginal over s-base, a dedicated
# cell's its whole month.
ML_CELL=${ML_CELL:?set ML_CELL to m-shared, l-shared, s-base, m-alone or l-alone}
POINT_NAME=ML-$ML_CELL
POSTURE=launch
S3LITE_LATENCY_MS=20
SERVERS=1
case $ML_CELL in
  m-shared|l-shared) TENANTS_MANIFEST=bench/k2cost/tenants/ml-$ML_CELL.json ;;
  s-base) TENANTS_MANIFEST=bench/k2cost/tenants/pack-s-mux-0048.json ;;
  m-alone|l-alone) ;;
  *) echo "ML_CELL $ML_CELL is not m-shared, l-shared, s-base, m-alone or l-alone" >&2; exit 2 ;;
esac
SERVER_ENV_EXTRA="TOKIO_WORKERS=2${SERVER_ENV_EXTRA:+ $SERVER_ENV_EXTRA}"
case $ML_CELL in *-alone)
  SERVER_ENV_EXTRA="CONTAINER_SHARE_K=1 CONTAINER_MEMORY_PRESSURE_BYTES=268435456 $SERVER_ENV_EXTRA" ;;
esac
if [ "${ML_SMOKE:-0}" = 1 ]; then
  POINT_NAME=$POINT_NAME-smoke
  PHASES="tenants --time-scale 0.15"
  LOAD_SECS=120
  QUIESCE_MIN_SECS=60
  QUIESCE_WINDOW_SECS=20
  QUIESCE_MAX_SECS=240
  IDLE_SECS=20
  USAGE_WAIT_SECS=120
else
  PHASES="tenants"
  LOAD_SECS=1380
  QUIESCE_MIN_SECS=240
  QUIESCE_WINDOW_SECS=60
  QUIESCE_MAX_SECS=600
  IDLE_SECS=60
fi
case $ML_CELL in
  m-alone) PHASES="
setup --streams 10 --prefix ml/m
group --streams 10 --prefix ml/m --group cdc-a --pull 100 --consumers 1 --settle every --wait-ms 20000 --duration $LOAD_SECS &
group --streams 10 --prefix ml/m --group cdc-b --pull 100 --consumers 1 --settle every --wait-ms 20000 --duration $LOAD_SECS &
tail --streams 10 --prefix ml/m --routing-keys 1 --via long-poll --readers 1 --wait-ms 20000 --duration $LOAD_SECS &
produce --streams 10 --prefix ml/m --rate 12.1 --records 100 --record-bytes 1024 --payload corpus --routing-keys 64 --duration $LOAD_SECS --seed 61
" ;;
  l-alone) PHASES="
setup --streams 50 --prefix ml/l
produce --streams 50 --prefix ml/l --rate 1.78 --records 1000 --record-bytes 1024 --payload corpus --duration $LOAD_SECS --seed 62
walk --streams 50 --prefix ml/l --parallel 8
" ;;
esac
QUIESCE=1
