# L3 smoke: write path and storage per byte (design §9.1 L3) at a tiny
# scale: 0.1 MB/s of corpus 1 KiB x 10 (10 req/s) for 60 s, then a short
# deferred tail. QUIESCE=1 QUIESCE_MIN_SECS=900 QUIESCE_WINDOW_SECS=120
# exercises the quiescence detector in about 20-25 minutes: 900 s is one
# GC cycle (600 s sweep + 300 s minimum age) counted from the last write
# burst, so the GC of the absorbed and compacted inputs falls inside the
# deferred window (a real point keeps the 1800 s floor, two cycles, and
# 300 s windows; 120 s ends the tail before that GC). The 60 s idle tail
# after the `quiesced` snapshot is the point's floor baseline.
POINT_NAME=L3-tiny
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
setup --streams 4 --prefix k2/l3
produce --streams 4 --prefix k2/l3 --mbps 0.1 --records 10 --record-bytes 1024 --payload corpus --duration 60 --seed 3
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=60
