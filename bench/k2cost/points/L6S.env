# L6 seal spike census point (SPIKE-PLAN.md §2.2, with SPIKE-PLAN-REVIEW.md
# B4 and A6). Modelled on layout5-proto's AB.env: one request shape per run,
# the same file and seed for every arm, fixed tails so both arms run the
# same length (the quiescence detector would end each arm at a different
# time). Throwaway: lives on the never-merged l6-spike branch.
#
#   env ARM=base SHARDS=1 STREAMS=8 MBPS=1 WAL_GAP=100 PAYLOAD=b64rand \
#     RECORDS=10 RECORD_BYTES=1024 bench/k2cost/run-local.sh bench/k2cost/points/L6S.env
#
# Arms: ARM=base is today's path (absorber, history2, the 5 s memtable
# ticker, the ring off). ARM=b (from M3 on) sets L6_SPILL=1 and the ring.
# Load: MBPS (payload MB/s, k2gen --mbps) or RATE (requests/s, --rate).
# s3lite: a 20 ms round trip, and (review B4) every PUT/UploadPart body
# capped at S3LITE_PUT_BPS bytes/s (default 25 MB/s, both arms; 0 = the
# uncapped sensitivity arm). The cap needs the l6-spike s3lite; an older
# rig ignores the variable (uncapped).
#
# Phases: setup of STREAMS JSON streams; 30 s warm-up of 300 B singles at
# 2 req/s (seed 2) that meets the cold shard's first-touch 503s; LOAD_SECS
# of open-loop load (seed SEED); an audit of every acked record; a fixed
# TAIL_SECS deferred tail with no client traffic; the audit again; FLOOR_SECS
# of idle as the floor reference. QUIESCE=0.
ARM=${ARM:?ARM=base|b}
SHARDS=${SHARDS:-1}
STREAMS=${STREAMS:-8}
WAL_GAP=${WAL_GAP:-100}
PAYLOAD=${PAYLOAD:-b64rand}
RECORDS=${RECORDS:-10}
RECORD_BYTES=${RECORD_BYTES:-1024}
LOAD_SECS=${LOAD_SECS:-1200}
TAIL_SECS=${TAIL_SECS:-1200}
FLOOR_SECS=${FLOOR_SECS:-300}
SEED=${SEED:-3}
S3LITE_PUT_BPS=${S3LITE_PUT_BPS:-25000000}
if [ -n "${RATE:-}" ]; then
  LOAD="--rate $RATE"
  LOAD_TAG=r$RATE
else
  MBPS=${MBPS:-1}
  LOAD="--mbps $MBPS"
  LOAD_TAG=m$MBPS
fi
case "$ARM" in
  base) SPILL=0; RING="TAIL_RING_BYTES=0" ;;
  b) SPILL=1; RING="TAIL_RING_BYTES=0 L6_RING_PROCESS_BYTES=${L6_RING_PROCESS_BYTES:-67108864} L6_RING_SHARD_BYTES=${L6_RING_SHARD_BYTES:-8388608}" ;;
  *) echo "L6S.env: ARM must be base or b" >&2; exit 2 ;;
esac
BW_TAG=$([ "$S3LITE_PUT_BPS" = 0 ] && echo -uncapped || echo)
# M6 (review B6): CELL_ROWS=1 adds the shared-cell posture rows of
# deploy/profiles/shared-cell.env that bound memory (the per-project memory
# line, k = 8, the instance's unabsorbed-bytes line); the cell envelope stays
# off (one project in the rig carries what the launch cell spreads over 8).
# The point name gains "-sc".
CELL_ROWS=${CELL_ROWS:-0}
if [ "$CELL_ROWS" = 1 ]; then
  CELL_ENV="PROJECT_MEMORY_PRESSURE_BYTES=33554432 PROJECT_SHARE_K=8 MAX_UNABSORBED_BYTES_PER_INSTANCE=536870912"
  CELL_TAG=-sc
else
  CELL_ENV=
  CELL_TAG=
fi
POINT_NAME=${POINT_NAME:-L6S-${L6_LABEL:-$ARM}-$PAYLOAD-${RECORD_BYTES}x$RECORDS-$LOAD_TAG-g$WAL_GAP-s$SHARDS-n$STREAMS$BW_TAG$CELL_TAG}
S3LITE_LATENCY_MS=20
SERVERS=1
# M6: every customer stream's frame bytes in each scrape line up to 4,096
# streams (bench/k2cost/scrape.py; the default keeps 256).
export K2_PER_STREAM_MAX=${K2_PER_STREAM_MAX:-4096}
# L6_EXTRA: further KEY=VALUE server settings for a point (spike knobs).
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS WAL_FLUSH_GAP_MS=$WAL_GAP L6_SPILL=$SPILL ADMIT_RSS_SHED_MB=2000 $RING $CELL_ENV ${L6_EXTRA:-}"
S="--streams $STREAMS --prefix k2/l6s"
PHASES="
setup $S --format json
produce $S --rate 2 --records 1 --record-bytes 300 --payload corpus --duration 30 --seed 2
produce $S $LOAD --records $RECORDS --record-bytes $RECORD_BYTES --payload $PAYLOAD --duration $LOAD_SECS --seed $SEED
audit $S --expect \$RUN/phase-2.ledger.json,\$RUN/phase-3.ledger.json --parallel 4
idle $TAIL_SECS
audit $S --expect \$RUN/phase-2.ledger.json,\$RUN/phase-3.ledger.json --parallel 4
idle $FLOOR_SECS
"
QUIESCE=0
IDLE_SECS=0
