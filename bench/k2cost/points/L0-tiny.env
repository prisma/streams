# L0 smoke: calibrate the servers' logical store totals against s3lite's
# physical ledger over a mixed workload (design §9.1 L0) at a tiny scale:
# batched appends, a catch-up walk, a few create/append/read/delete
# lifecycles. About 1,300 requests, about 12 MB.
POINT_NAME=L0-tiny
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
setup --streams 2 --prefix k2/l0
produce --streams 2 --prefix k2/l0 --rate 20 --records 10 --record-bytes 1024 --payload corpus --duration 60 --seed 1
walk --streams 2 --prefix k2/l0 --from earliest
churn --count 5 --size-kib 4 --end delete --prefix k2/l0c --concurrency 1
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=30
