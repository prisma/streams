# SCR-S: screening point for Fable's profile S (streams-cost report
# 2026-10-24 §4.1) on the launch posture: one shared-cell server
# (compute-1g.env + shared-cell.env: one shard, fleet off, ring off,
# 32/16 MiB caches), s3lite at 20 ms. About 20-25 minutes:
#
#   20 streams of 1 KiB JSON singles at 2 req/s (open-loop Poisson);
#   a long-poll tail on every stream;
#   one consumer group (pull max 10, settle each) on 5 of the streams,
#   which take a quarter of the appends (0.5 of the 2 req/s).
#
# The group's streams are unkeyed, as the tails need: a read without a
# routing key reads only unkeyed records. At 0.1 append/s per stream a pull
# finds about one record whatever its max. Pulls wait up to 20 s for a
# record, as the SDK's consumers do (sdk/src/index.ts, queue_runner.ts).
#
# Load LOAD_SECS (840), then a short quiescence (240 s quiet in 60 s
# windows, given up after 600 s: the deferred window is a lower bound on
# history work, not §8's two GC cycles), then 60 s of idle tail, the
# point's own floor baseline. SCR_SMOKE=1 shortens it to about 6 minutes
# (60 s of load). The rig sets QUIESCE_* and IDLE_SECS before it reads a
# point, so this point sets them plainly; LOAD_SECS and SCR_SMOKE come from
# the caller.
#
# Verdict counts (counts.py RUN; a pair: counts.py --compare REF CAND):
# window `to_quiesced` (and `phases 3-5`, the load alone): shard/sst/get
# (the live tails' store reads: the ring and E2 levers), shard/wal/put with
# pump_flushes (WAL windows), put_bytes (the binary billing row), class_a
# and class_b.
POINT_NAME=SCR-S
POSTURE=launch
S3LITE_LATENCY_MS=20
SERVERS=1
if [ "${SCR_SMOKE:-0}" = 1 ]; then
  POINT_NAME=SCR-S-smoke
  LOAD_SECS=${LOAD_SECS:-60}
  QUIESCE_MIN_SECS=60
  QUIESCE_WINDOW_SECS=20
  QUIESCE_MAX_SECS=240
  IDLE_SECS=20
  USAGE_WAIT_SECS=120
else
  LOAD_SECS=${LOAD_SECS:-840}
  QUIESCE_MIN_SECS=240
  QUIESCE_WINDOW_SECS=60
  QUIESCE_MAX_SECS=600
  IDLE_SECS=60
fi
PHASES="
setup --streams 15 --prefix scr/s/tail
setup --streams 5 --prefix scr/s/group
tail --streams 15 --prefix scr/s/tail --via long-poll --readers 1 --rate 1.5 --records 1 --record-bytes 1024 --payload corpus --duration $LOAD_SECS --seed 41 &
tail --streams 5 --prefix scr/s/group --via long-poll --readers 1 --duration $LOAD_SECS &
group --streams 5 --prefix scr/s/group --group scr-s --pull 10 --consumers 1 --settle every --wait-ms 20000 --rate 0.5 --records 1 --record-bytes 1024 --payload corpus --duration $LOAD_SECS --seed 42
"
QUIESCE=1
