# L5 smoke: the read and consumer paths (design §9.1 L5) at a tiny scale:
# seed 6 MB unkeyed (k2/l5) and 150 keyed records over 16 routing keys
# (k2/l5g), restart (cold), a catch-up walk verified record for record
# against the produce ledger, a long-poll tail beside a 10 req/s
# producer, and a consumer group pulling 10 with a settle per batch until
# the keyed backlog is drained. Load under 3 minutes, peak 20 req/s of
# producers.
#
# A pull leases at most one message per routing key (per-key FIFO), so
# unkeyed data delivers one message per pull whatever --pull says: groups
# read keyed streams. Reads filter by key, so walks read unkeyed streams
# (or pass --routing-keys K to read each key). "\$RUN" in a phase line is
# the results directory (the rig expands it when it runs the line).
POINT_NAME=L5-tiny
S3LITE_LATENCY_MS=40
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
setup --streams 2 --prefix k2/l5
setup --streams 2 --prefix k2/l5g
produce --streams 2 --prefix k2/l5 --rate 20 --records 10 --record-bytes 1024 --payload corpus --duration 30 --seed 5
produce --streams 2 --prefix k2/l5g --rate 10 --records 1 --routing-keys 16 --record-bytes 1024 --payload corpus --duration 15 --seed 7
restart
walk --streams 2 --prefix k2/l5 --from earliest --expect \$RUN/phase-3.ledger.json
tail --streams 2 --prefix k2/l5 --via long-poll --rate 10 --records 1 --record-bytes 1024 --payload corpus --duration 30 --seed 8
group --streams 2 --prefix k2/l5g --pull 10 --settle every --until-empty 1 --duration 60
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=0
