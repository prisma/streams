# L6 spike M9 consumer-group freeze check (owner call 12; SPIKE-PLAN-REVIEW
# B3 and M-1). Derived from bench/k2cost/points/L6S.env at 00d6b7e2.
# Throwaway: lives on the never-merged l6-spike branch.
#
#   spike-run.sh M9 POINT=L6S-group.env ARM=b
#   ... L6_LABEL=b-pages L6_EXTRA=L6_SPILL_TRIGGER=pages   (the control)
#
# Shape (review B3): 1 shard, 8 UNKEYED JSON streams, corpus 1 KiB x 10 at
# --mbps 1 (seed 3, M9's producer), and a live consumer group with run leases
# on every stream (--pull 100 --settle every, CONSUMERS per stream), so
# delivered records per second are about the produced ones: the lease and ack
# rows in the memtable are about twice the page bytes (rBn F1's ratio).
#
# Phases (census-beta.py maps them onto census.py's 1-7): 1 setup, 2 warm-up,
# 3 the producer (background) and 4 the group (foreground), LOAD_SECS each;
# 5 audit, 6 tail, 7 audit, 8 floor.
ARM=${ARM:?ARM=base|b}
SHARDS=${SHARDS:-1}
STREAMS=${STREAMS:-8}
WAL_GAP=${WAL_GAP:-100}
MBPS=${MBPS:-1}
PULL=${PULL:-100}
CONSUMERS=${CONSUMERS:-2}
LOAD_SECS=${LOAD_SECS:-1200}
TAIL_SECS=${TAIL_SECS:-1200}
FLOOR_SECS=${FLOOR_SECS:-300}
S3LITE_PUT_BPS=${S3LITE_PUT_BPS:-25000000}
case "$ARM" in
  base) SPILL=0; RING="TAIL_RING_BYTES=0" ;;
  b) SPILL=1; RING="TAIL_RING_BYTES=0 L6_RING_PROCESS_BYTES=${L6_RING_PROCESS_BYTES:-67108864} L6_RING_SHARD_BYTES=${L6_RING_SHARD_BYTES:-8388608}" ;;
  *) echo "L6S-group.env: ARM must be base or b" >&2; exit 2 ;;
esac
BW_TAG=$([ "$S3LITE_PUT_BPS" = 0 ] && echo -uncapped || echo)
POINT_NAME=${POINT_NAME:-L6S-group-${L6_LABEL:-$ARM}-corpus-1024x10-m$MBPS-p$PULL-c$CONSUMERS-g$WAL_GAP-s$SHARDS-n$STREAMS$BW_TAG}
S3LITE_LATENCY_MS=20
SERVERS=1
export K2_PER_STREAM_MAX=${K2_PER_STREAM_MAX:-4096}
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS WAL_FLUSH_GAP_MS=$WAL_GAP L6_SPILL=$SPILL ADMIT_RSS_SHED_MB=2000 $RING ${L6_EXTRA:-}"
S="--streams $STREAMS --prefix k2/l6s"
PHASES="
setup $S --format json
produce $S --rate 2 --records 1 --record-bytes 300 --payload corpus --duration 30 --seed 2
produce $S --mbps $MBPS --records 10 --record-bytes 1024 --payload corpus --duration $LOAD_SECS --seed 3 &
group $S --pull $PULL --consumers $CONSUMERS --settle every --group g$PULL --duration $LOAD_SECS --seed 6
audit $S --expect \$RUN/phase-2.ledger.json,\$RUN/phase-3.ledger.json --parallel 4
idle $TAIL_SECS
audit $S --expect \$RUN/phase-2.ledger.json,\$RUN/phase-3.ledger.json --parallel 4
idle $FLOOR_SECS
"
QUIESCE=0
IDLE_SECS=0
