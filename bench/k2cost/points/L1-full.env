# L1: the WAL function W(r, G, RTT) (design §9.1 L1). One shard,
# open-loop Poisson 1 KiB singles, r in {1,3,10,30,100,300} req/s for
# 180 s each, back to back, then two 1 KiB x 100 points (r = 3, 30) to
# show W does not depend on request bytes. WAL counts are immediate, so
# no quiescence. The idle baseline (the billing cadence, subtracted per
# cell by price.py) comes AFTER a 60 s warm-up at 1 req/s over every
# stream, so the shard DB and the streams' history DBs it stands for are
# open (absorption opens them ABSORB_AGE_SECS after the first append; the
# warm-up's absorption and GC in the idle window are booked to produce,
# never to the floor). price.py's W(r) table reports WAL PUT/s per active
# shard above that floor against acked req/s per shard.
#
# The grid is G x RTT: WAL_GAP in {10, 100 (the binary's default, the one
# write tier since 2026-10-07), 250, 500, 1000} and
# LAT in {20, 40} ms, e.g.
#   WAL_GAP=500 LAT=40 bench/k2cost/run-local.sh bench/k2cost/points/L1-full.env
# The closed-loop arm: ARM=closed (the same r grid as
# --concurrency C = r x 0.05 s rounded up, a Little's-law first guess).
WAL_GAP=${WAL_GAP:-100}
LAT=${LAT:-20}
ARM=${ARM:-open}
POINT_NAME=L1-full-$ARM-g$WAL_GAP-rtt$LAT
S3LITE_LATENCY_MS=$LAT
SERVERS=1
SERVER_ENV_EXTRA="INITIAL_SHARDS=1 WAL_FLUSH_GAP_MS=$WAL_GAP"
S="--streams 8 --prefix k2/l1 --records 1 --record-bytes 1024 --payload corpus"
if [ "$ARM" = closed ]; then
  PHASES="
setup --streams 8 --prefix k2/l1
produce $S --rate 1 --duration 60 --seed 10
idle 300
produce $S --concurrency 1 --duration 180 --seed 11
produce $S --concurrency 1 --duration 180 --seed 12
produce $S --concurrency 1 --duration 180 --seed 13
produce $S --concurrency 2 --duration 180 --seed 14
produce $S --concurrency 5 --duration 180 --seed 15
produce $S --concurrency 15 --duration 180 --seed 16
"
else
  PHASES="
setup --streams 8 --prefix k2/l1
produce $S --rate 1 --duration 60 --seed 10
idle 300
produce $S --rate 1 --duration 180 --seed 11
produce $S --rate 3 --duration 180 --seed 12
produce $S --rate 10 --duration 180 --seed 13
produce $S --rate 30 --duration 180 --seed 14
produce $S --rate 100 --duration 180 --seed 15
produce $S --rate 300 --duration 180 --seed 16
produce --streams 8 --prefix k2/l1 --records 100 --record-bytes 1024 --payload corpus --rate 3 --duration 180 --seed 17
produce --streams 8 --prefix k2/l1 --records 100 --record-bytes 1024 --payload corpus --rate 30 --duration 180 --seed 18
"
fi
QUIESCE=0
IDLE_SECS=0
