# PACK-S: PACK_N tenants of Fable's profile S, small (streams-cost report
# 2026-10-24 §4.1), packed onto one launch-posture cell, to price a tenant at
# scale (README "Packing"). Tenants mode: tenants/pack-s-NNNN.json's projects
# (PACK_N = 1, 5, 10, 20, 30 or 46) admitted through cell-admin on
# compute-1g.env + shared-cell.env (one shard, fleet off, the 8 MiB ring,
# 32/16 MiB caches, k = 8), each with its own token: 20 streams of 1 KiB JSON
# singles at 2 appends a second, a long-poll tail on every stream, one
# consumer group (pull max 10, settle each) on 5 of them. A project holds 25
# parked waits, so 46 is the most the cell's live pool of 1,200
# (SSE_MAX_CONNECTIONS) parks with room to spare; past it waits stay active
# and count against the write gate's 512. s3lite at 20 ms. TOKIO_WORKERS=2
# is what the binary runs on a 1-vCPU instance (one per core, never below
# two: src/config/model.rs worker_threads), not this host's 20.
#
# About 40 minutes: admission, the manifest's 1,640 s (setup 0-120 s, the
# load from 180 s, the verdict window `period steady` 360-1,560 s), a short
# quiescence (240 s quiet in 60 s windows, given up after 600 s), 60 s of
# idle tail, the usage read and the audit. PACK_SMOKE=1 runs the manifest at
# time scale 0.15 (about 4 min of run) with a short quiescence: for checking
# a setup, not for a verdict.
#
# Verdict: packing.py price RUN (the rig runs it): the instance's month at
# the owner's prices from `period steady`, per tenant, against the K2 bill;
# packing.py curve RUN... sets the steps side by side.
PACK_N=${PACK_N:?set PACK_N to the tenant count: 1, 5, 10, 20, 30 or 46 (tenants/pack-s-NNNN.json)}
POINT_NAME=PACK-S-$(printf %04d "$PACK_N")
POSTURE=launch
S3LITE_LATENCY_MS=20
SERVERS=1
TENANTS_MANIFEST=bench/k2cost/tenants/pack-s-$(printf %04d "$PACK_N").json
# PACK_MUX=1: the multiplexed driver (layout 6A package 2): each project
# waits through one `mux` phase (tenants/pack-s-mux-NNNN.json, PACK_N = 48,
# 100 or 150), one parked wait where the per-stream point holds 25.
if [ "${PACK_MUX:-0}" = 1 ]; then
  POINT_NAME=PACK-S-MUX-$(printf %04d "$PACK_N")
  TENANTS_MANIFEST=bench/k2cost/tenants/pack-s-mux-$(printf %04d "$PACK_N").json
fi
SERVER_ENV_EXTRA="TOKIO_WORKERS=2${SERVER_ENV_EXTRA:+ $SERVER_ENV_EXTRA}"
if [ "${PACK_SMOKE:-0}" = 1 ]; then
  POINT_NAME=$POINT_NAME-smoke
  PHASES="tenants --time-scale 0.15"
  QUIESCE_MIN_SECS=60
  QUIESCE_WINDOW_SECS=20
  QUIESCE_MAX_SECS=240
  IDLE_SECS=20
  USAGE_WAIT_SECS=120
else
  PHASES="tenants"
  QUIESCE_MIN_SECS=240
  QUIESCE_WINDOW_SECS=60
  QUIESCE_MAX_SECS=600
  IDLE_SECS=60
fi
QUIESCE=1
