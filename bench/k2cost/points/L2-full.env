# L2: the shard-count lever (design §9.1 L2). 200 req/s of 1 KiB x 10
# spread over 64 streams on S shards for 300 s after a 120 s idle
# baseline; check W_total = sum W(r/S). The grid is S in {1, 4, 16} x
# G in {10, 1000}:
#   SHARDS=16 WAL_GAP=1000 bench/k2cost/run-local.sh bench/k2cost/points/L2-full.env
SHARDS=${SHARDS:-4}
WAL_GAP=${WAL_GAP:-10}
POINT_NAME=L2-full-s$SHARDS-g$WAL_GAP
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA="INITIAL_SHARDS=$SHARDS WAL_FLUSH_GAP_MS=$WAL_GAP"
PHASES="
setup --streams 64 --prefix k2/l2
idle 120
produce --streams 64 --prefix k2/l2 --rate 200 --records 10 --record-bytes 1024 --payload corpus --duration 300 --seed 2
"
QUIESCE=0
IDLE_SECS=0
