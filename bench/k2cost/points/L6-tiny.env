# L6 smoke: fixed costs (design §9.1 L6) at a tiny scale: open 4 shards
# with a 10 s touch, then 60 s idle. SERVERS=2 runs the T-launch shape
# (2 servers + pilot router, rollup on streams-1):
#   SERVERS=2 bench/k2cost/run-local.sh bench/k2cost/points/L6-tiny.env
SERVERS=${SERVERS:-1}
POINT_NAME=L6-tiny-n$SERVERS
S3LITE_LATENCY_MS=20
SERVER_ENV_EXTRA=""
PHASES="
setup --streams 8 --prefix k2/l6
produce --streams 8 --prefix k2/l6 --rate 8 --records 1 --record-bytes 1024 --payload corpus --duration 10 --seed 6
idle 60
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=0
