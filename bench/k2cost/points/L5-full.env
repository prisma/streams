# L5: the read and consumer paths (design §9.1 L5), run early. RTT 40 ms,
# 4 shards, 32 streams: 1 GiB of `bytes` 1 KiB singles over 16 streams
# (k2/l5b) and 1 GiB of corpus 1 KiB x 100 over 16 streams (k2/l5j).
# Plus 132 MiB of keyed corpus 1 KiB singles over 1,024 routing keys on
# 16 more streams (k2/l5k): a pull leases at most one message per routing
# key (per-key FIFO, src/queue.rs), so unkeyed data would deliver one
# message per pull whatever --pull says, and reads filter by key, so the
# keyed streams are read per key.
# After the seed the rig waits for quiescence (`quiesce`): the seed's
# absorption, history compaction and GC run there and are priced as
# produce's deferred cost, not in the read phases that follow.
# Then: (a) cold walk after a restart, (b) warm walk, (c) 3 walkers 10 min
# apart, (d) lagged readers at 30 s and 5 min beside 100 req/s of
# producers, plus the same producers alone, (e) keyed reads (each stream
# once per routing key, 10 min cap), (f) a long-poll tail beside 200 req/s
# versus the producers alone, 10 min each, (g) consumer groups pulling
# 10/100/1000 with a settle per batch on the keyed streams: backlog only
# (until the group's backlog is empty, 10 min cap, so the window prices
# the drain and not idle pulls), and beside 100 req/s of keyed producers
# for 10 min, plus those producers alone.
# Per GiB delivered = readPayloadBytes; price.py books every cell of a
# group by its driver (§4.3); the producer-only arms give an on-minus-off
# cross-check for (d), (f) and (g).
POINT_NAME=L5-full
S3LITE_LATENCY_MS=40
SERVERS=1
SERVER_ENV_EXTRA="INITIAL_SHARDS=4"
B="--streams 16 --prefix k2/l5b"
J="--streams 16 --prefix k2/l5j"
K="--streams 16 --prefix k2/l5k"
P="--records 10 --record-bytes 1024 --payload corpus"
KP="--records 1 --record-bytes 1024 --payload corpus --routing-keys 1024"
PHASES="
setup $B --format bytes
setup $J --format json
setup $K --format json
produce $B --rate 600 --records 1 --record-bytes 1024 --payload bytes --duration 1800 --seed 51
produce $J --mbps 4 --records 100 --record-bytes 1024 --payload corpus --duration 270 --seed 52
produce $K --rate 500 $KP --duration 270 --seed 50
quiesce
restart
walk $B --from earliest --parallel 4
walk $J --from earliest --parallel 4
walk $B --from earliest --parallel 4
walk $J --from earliest --parallel 4
walk $J --from earliest --readers 3 --stagger 600 --parallel 4
walk $J --from lag:30 --rate 100 $P --duration 600 --seed 53
walk $J --from lag:300 --rate 100 $P --duration 900 --seed 54
produce $J --rate 100 $P --duration 600 --seed 60
walk $K --routing-keys 1024 --from earliest --parallel 16 --duration 600
tail $J --via long-poll --rate 200 $P --duration 600 --seed 55
produce $J --rate 200 $P --duration 600 --seed 56
group $K --pull 10 --settle every --until-empty 1 --duration 600 --group g10
group $K --pull 100 --settle every --until-empty 1 --duration 600 --group g100
group $K --pull 1000 --settle every --until-empty 1 --duration 600 --group g1000
group $K --pull 10 --settle every --rate 100 $KP --duration 600 --group g10p --seed 57
group $K --pull 100 --settle every --rate 100 $KP --duration 600 --group g100p --seed 58
group $K --pull 1000 --settle every --rate 100 $KP --duration 600 --group g1000p --seed 59
produce $K --rate 100 $KP --duration 600 --seed 61
"
QUIESCE=0
IDLE_SECS=0
