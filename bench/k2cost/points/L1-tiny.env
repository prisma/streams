# L1 smoke: the WAL function W(r, G, RTT) at a tiny scale (design §9.1 L1).
# One shard, open-loop Poisson 1 KiB singles at 3 and 10 req/s for 30 s
# each, after a 10 s warm-up at 2 req/s (opens the shard and history DBs)
# and a 70 s idle baseline with those DBs open (it holds the warm-up's
# absorption at ABSORB_AGE_SECS = 60, which price.py books to produce).
# About 420 requests, under 1 MB, 2.5 minutes of load.
POINT_NAME=L1-tiny
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA="INITIAL_SHARDS=1"
PHASES="
setup --streams 2 --prefix k2/l1
produce --streams 2 --prefix k2/l1 --rate 2 --records 1 --record-bytes 1024 --payload corpus --duration 10 --seed 10
idle 70
produce --streams 2 --prefix k2/l1 --rate 3 --records 1 --record-bytes 1024 --payload corpus --duration 30 --seed 11
produce --streams 2 --prefix k2/l1 --rate 10 --records 1 --record-bytes 1024 --payload corpus --duration 30 --seed 12
"
QUIESCE=${QUIESCE:-0}
IDLE_SECS=0
