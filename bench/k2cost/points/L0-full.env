# L0: calibrate the logical store totals (and C1 attempts, once landed)
# against s3lite's physical ledger, cell by cell (design §9.1 L0). Every
# op: 2 MB/s of 1 KiB x 10 for 20 min over 8 streams on 4 shards (about
# 600 MB per shard, so compaction writes 32 MiB multipart outputs), a
# catch-up walk (GETs, paged LISTs), 200 create/append/read/delete
# lifecycles (deletes, 404 probes), then quiescence (GC LISTs and bulk
# deletes). Pass: logical == physical for every mapped cell.
POINT_NAME=L0-full
S3LITE_LATENCY_MS=20
SERVERS=1
SERVER_ENV_EXTRA=""
PHASES="
setup --streams 8 --prefix k2/l0
produce --streams 8 --prefix k2/l0 --rate 200 --records 10 --record-bytes 1024 --payload corpus --duration 1200 --seed 1
walk --streams 8 --prefix k2/l0 --from earliest --parallel 4
churn --count 200 --size-kib 64 --end delete --prefix k2/l0c --concurrency 4
"
QUIESCE=1
IDLE_SECS=0
