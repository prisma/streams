# P1: tuning P1's read-path measurement (PLAN.md §3 rung 2, the habanero
# scale bench's population mode, compressed in time): one dedicated
# launch-posture server (compute-1g.env + shared-cell.env as run-local layers
# them, PROJECT_SHARE_K=1 so a read without maxBytes keeps its 8 MiB page),
# s3lite counting the store's requests by cell and status. P1_CELL picks:
#   retain  P1_STREAMS (100,000) streams, then two passes of touches in
#           order at P1_RATE (300) a second, each an append of one 64-byte
#           record and a records read: a stream is touched every
#           P1_STREAMS / P1_RATE seconds (5.5 min), long past the descriptor
#           cache's 5 s TTL and its sweep, as 1M streams touched hourly
#           are. Read: the registry's GETs in `phase 2` and `phase 3`, those
#           answered 304 against those answered 200 (the retained tier's
#           pass bar: >= 95% 304 at the default 62 MiB).
#   burst   1,000 streams of one record, 30 s idle (past the TTL), then 1,000
#           concurrent reads of them without maxBytes against s3lite at
#           100 ms: every read cold, waiting on the store. Read: the touch
#           ledger's status counts (the pass bar: no 503 read_memory_busy).
P1_CELL=${P1_CELL:?set P1_CELL to retain or burst}
POINT_NAME=P1-$P1_CELL
POSTURE=launch
SERVERS=1
SERVER_ENV_EXTRA="PROJECT_SHARE_K=1 TOKIO_WORKERS=2${SERVER_ENV_EXTRA:+ $SERVER_ENV_EXTRA}"
QUIESCE=0
IDLE_SECS=0
case $P1_CELL in
  retain)
    S3LITE_LATENCY_MS=${S3LITE_LATENCY_MS:-20}
    N=${P1_STREAMS:-100000}
    RATE=${P1_RATE:-300}
    # At these populations /v1/debug/usage is about 1.2M allocations a call.
    [ "$N" -le 10000 ] || SCRAPE_USAGE_SECS=${SCRAPE_USAGE_SECS:-0}
    PHASES="
setup --streams $N --prefix p1/r --parallel 64
touch --streams $N --prefix p1/r --rate $RATE --passes 1 --concurrency 512
touch --streams $N --prefix p1/r --rate $RATE --passes 1 --concurrency 512
" ;;
  burst)
    S3LITE_LATENCY_MS=${S3LITE_LATENCY_MS:-100}
    PHASES="
setup --streams 1000 --prefix p1/b --parallel 64
touch --streams 1000 --prefix p1/b --rate 200 --passes 1 --concurrency 64
idle 30
touch --streams 1000 --prefix p1/b --rate 0 --passes 1 --concurrency 1000 --append 0
" ;;
  *) echo "P1_CELL $P1_CELL is not retain or burst" >&2; exit 2 ;;
esac
