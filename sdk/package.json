{
  "name": "@prisma/streams",
  "version": "0.3.0-beta.1",
  "description": "Prisma Streams product SDK — encrypted, append-only collections with routing keys, consumers, and watches",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma/streams.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/prisma/streams/tree/HEAD/sdk#readme",
  "bugs": {
    "url": "https://github.com/prisma/streams/issues"
  },
  "keywords": [
    "prisma",
    "streams",
    "durable-streams",
    "event-streaming",
    "append-only",
    "encryption",
    "consumer-groups"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs && node scripts/auth-behavior.mjs && node scripts/watch-capability-vector.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
