{
  "name": "@prisma/streams",
  "version": "0.2.0-rc.4",
  "description": "Prisma Streams product SDK — encrypted, append-only collections with routing keys, consumers, and watches",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs && node scripts/auth-behavior.mjs && node scripts/watch-capability-vector.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
