# The binary defaults. SLATE_S3_ENDPOINT is a required clap field with no
# default (cli.rs), so "defaults" means that one placeholder and no argv.
# Leg C adds --listen 127.0.0.1:<free> and points the endpoint at s3lite.
# K2, K4, K5, K6 and K10-K12 derive from this family.
env SLATE_S3_ENDPOINT=https://placeholder-endpoint.invalid
