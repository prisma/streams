# Memory-survival profile for the 1-GiB Prisma Compute instance class
# (OOM review, 2026-08-07). MEMORY knobs only — topology
# (INITIAL_SHARDS, FLEET_*) stays with each campaign's script.
#
# Every active deploy script sources this file and passes each line as
# --env; opting out requires UNSAFE_LEGACY_MEMORY_PROFILE=1
# explicitly. Values must be space-free (they are split into flags).
#
# A gather reserves min(capacity, max(ABSORB_GATHER_MAX_BYTES x3,
# worst-frame transient)); the binary floors the budget at the
# worst frame ((body ceiling + 64 KiB) x3 build multiplier ≈ 96 MiB at
# the 32 MiB pin). At this budget EVERY gather — not just oversized
# ones — runs ONE AT A TIME, so the slot count below is the effective
# truth. The startup summary prints the per-gather reservation, the
# configured slots, and the EFFECTIVE concurrency.
#
# DO NOT raise ABSORB_GLOBAL_GATHERS on a 1 GiB instance. An earlier
# version of this comment advised GATHERS=2 with a doubled budget; the
# 2026-08-09 chaos campaign ran GATHERS=4 in Singapore and the kernel
# OOM-killed the process (exit 137) roughly fifteen minutes in, while
# RSS was 362 MB against a 500 MB shed line and the reservations were
# accounted for exactly. The per-gather reservation UNDERSTATES the
# real transient of a concurrent gather; until that model is re-derived
# and validated, more slots trades a bounded, observable backlog for an
# unbounded fatal one. See docs/CHAOS-CAMPAIGN.md, CHAOS-5.
ABSORB_GATHER_MAX_BYTES=8388608
ABSORB_GLOBAL_BUDGET_BYTES=100859904
ABSORB_GLOBAL_GATHERS=1
SLATEDB_RT_THREADS=4
TELEMETRY_CACHE_BYTES=16777216
SHARED_CACHE_BYTES=134217728
HISTORY_CACHE_BYTES=33554432
POSTINGS_CACHE_BYTES=67108864
MAX_UNFLUSHED_BYTES=16777216
L0_SST_SIZE_BYTES=8388608
L0_MAX_SSTS=32
ADMIT_RSS_SHED_MB=500
# R27-4: instance-wide byte bound on in-flight SST-class store transfers
# (flush + compaction, ALL resident DBs). At WAN store RTT (SIN: 20-40 ms)
# every DB's compaction overlaps every other's and the buffered-byte peak
# scales with latency: the incompressible campaign died at RSS 423->656 MB
# in ~60 s with the maintenance ledger healthy at 50-86 MB. Per-DB
# compactor limits do not compose; this is the only global bound.
# WAL/manifest/fleet classes are exempt.
#
# 32 MiB (was 48): the first gated SIN rerun (cap-20260813T051338Z)
# still died at RSS ~500->kill in one 31 s interval. The gate bounds
# bytes IN transfer, but a task queued at the gate has already built
# its payload — queue-held buffers are task-count x SST size, which
# the cap cannot touch. Hence BOTH knobs below.
STORE_BULK_INFLIGHT_MAX_BYTES=33554432
# One compaction executor per DB on 1 GiB (binary default is 4; the
# campaigns ran 2). ~7 resident DBs x (compactions + flush) each
# holding an 8-16 MiB payload while queued at the gate is 200-340 MB
# of un-gateable buffer mass at WAN latency; halving task count is
# the only lever that shrinks it without forking SlateDB admission.
COMPACTOR_MAX_CONCURRENT=1
# R27-4 wave anatomy (oomr6 rig): with the gate pinned at cap and
# COMPACTOR_MAX_CONCURRENT=1, RSS still waved 478->886 MB in 30 s.
# The mass is the compaction worker's OWN memory model at upstream
# defaults: 4 subcompactions, each with per-input read-ahead of
# max_fetch_tasks(4) x bytes_to_fetch(2 MiB) — a 32-input L0 merge
# can stage ~1 GB of completed prefetch the bulk gate cannot see
# (it bounds bytes in transit, not buffers already fetched). One
# subcompaction, 1 MiB single-task read-ahead, 32 MiB output rolls:
# worst-case staged prefetch drops to ~inputs x 1 MiB.
COMPACT_MAX_SUBCOMPACTIONS=1
COMPACT_MAX_FETCH_TASKS=1
COMPACT_BYTES_TO_FETCH=1048576
COMPACT_MAX_SST_SIZE_BYTES=33554432
