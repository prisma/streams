# Dedicated-cell profile: the shared cell's launch shape (shared-cell.env:
# ONE 1 GiB server, one shard, no routers, the fleet off) holding ONE
# project, k = 1 (decision record 2026-11-03, item C, Fable 5.1 under the
# owner's delegation): profile L (the large sink) is placed only here, and
# an M may be. Layer it ON TOP of compute-1g.env (later wins), INSTEAD of
# shared-cell.env, exactly as deploy scripts pass those files: every line
# is one --env, values must be space-free.
#
# It is shared-cell.env line for line except three values, each marked
# "Dedicated:" below: PROJECT_SHARE_K=1, the project's LiveFeed share and
# its memory line. k = 1 and the 256 MiB memory line are how
# bench/k2cost/points/ML.env ran its dedicated arms (m-alone, l-alone:
# shared-cell.env with PROJECT_SHARE_K=1 PROJECT_MEMORY_PRESSURE_BYTES=
# 268435456), which priced M and L dedicated. profile.test.ts pins the
# difference.
#
# deploy/cell-admin reads this file too (`init --profile` with both files):
# at k = 1 the ceilings are the bounds themselves, `init` takes
# --max-projects 1 only, and `admit` places one project, with no --weight.
# The server installs no ceiling at k = 1 (src/auth/ceiling.rs): the quotas
# cell-admin publishes, at the bounds, are the project's.
#
# Per-cell values the deploy step sets, NOT this file (secrets come from
# files, never from a profile): CELL_ID, PROJECT_ID (reserved, never placed:
# cell-admin refuses a customer project with this id), ACCOUNT_ID (the
# unowned-event sink: cell-admin refuses a customer workspace with this id),
# USAGE_STREAM_KEY (BILLING_MODE=required refuses to start without it),
# AUTH_TOKEN (the deployment bearer; an operator credential, never given to
# a customer), SLATE_S3_*, PATH_PREFIX, FEEDS_S3_{ENDPOINT,BUCKET,REGION}
# with its key pair FEEDS_S3_{ACCESS_KEY_ID,SECRET_ACCESS_KEY} (the bundle's
# own bucket and key: deploy/app-server reads the bundle by these names only,
# never by BIN_S3_*), and FEEDS_S3_KEY (the bundle
# cell-admin writes; deploy/app-server materializes it into the three files
# below).
#
# Deliberately ABSENT, and nothing may add them:
# - FLEET_PREFIX: fleet off (one server, no heartbeat, no scaler). With it
#   absent every SCALE_* threshold is inert, so none is set here; a 100 ms
#   write tier's p99 also stays below SCALE_EDGE_LATENCY_MS's 1000 default.
# - FLEET_INTERNAL_TOKEN and WORKLOAD_TOKEN_FILE: with no static token and
#   no key pinned to prisma-streams-internal in the keys feed (cell-admin
#   only ever publishes prisma-streams-data keys), nothing can open the
#   /v1/internal surface of a single-server cell (PLAN step 8, H6).
# - WAL_FLUSH_GAP_MS and TELEMETRY_DRAIN_SECS: the write tier (one 100 ms
#   tier for every cell, owner 2026-10-07) is the binary's default: the
#   100 ms flush gap since edge change #97, the 8 s usage drain once it lands.
# - KEEP_AWAKE_UNTIL_MS, here or per cell: it would end the keep-awake
#   guard (KEEP_AWAKE, below) at that instant. cell-admin refuses a
#   profile that sets it; it cannot see the per-cell values.
STREAMS_AUTH_MODE=enforce
# The release posture (owner decision 2026-10-08, README "Shared cells Q6"
# (b)): no static or bridge credential, the record ceiling, the ring and a
# bounded SSE cap, checked at boot. On this fleet-off cell it holds with
# FLEET_AUTH_MODE at its default and neither token present.
STREAMS_RELEASE_POSTURE=1
STREAMS_AUTH_KEYS_FILE=/tmp/feeds/keys.json
STREAMS_AUTH_POLICY_FILE=/tmp/feeds/policies.json
STREAMS_AUTH_GRANTS_FILE=/tmp/feeds/grants.json
BILLING_MODE=required
# The only server is the rollup owner: without it no month ever closes.
ROLLUP=1
# Kept awake (the owner's public-beta answer (4) of 2026-10-11, "Keep
# awake"): the wrapper, not the binary, reads this and holds Compute's
# keep-awake guard for the process's life. The cell does not sleep when
# idle, so after a quiet spell a client neither waits for a wake nor meets
# the platform's 404 while one is under way; a deploy or a restart still
# boots it cold. It bills for every hour it is up. cell-admin requires it.
KEEP_AWAKE=1
# One shard; set at keyspace creation and stored with the topology.
INITIAL_SHARDS=1
# Dedicated: k = 1, one project holding the whole cell. The server installs
# no ceiling at k = 1 and ignores the weights; cell-admin's ceilings are the
# bounds below, at which it publishes the project's quotas.
PROJECT_SHARE_K=1
# The bounds, stated here so a change to a binary default or to
# compute-1g.env cannot move a dedicated cell's ceilings silently: 512
# inflight, 1,200 subscriptions, 512 MiB of appended bytes not yet absorbed
# (queued_append_bytes).
ADMIT_MAX_INFLIGHT=512
SSE_MAX_CONNECTIONS=1200
MAX_UNABSORBED_BYTES_PER_INSTANCE=536870912
# The measured 1 GiB envelope (requests/s, append bytes/s, read bytes/s),
# PENDING re-measurement on this one-shard shape (the envelope arm).
# The one project's ceilings: 1,411 req/s, 2,060,000 B/s appended,
# 30,000,000 B/s read.
CELL_ENVELOPE_REQUESTS_PER_SEC=1411
CELL_ENVELOPE_APPEND_BYTES_PER_SEC=2060000
CELL_ENVELOPE_READ_BYTES_PER_SEC=30000000
# The stored bytes a project may own when its policy sets none: 10 GiB
# (stored-cap Q1 (a), accepted by the owner on 2026-10-12, S1). Not a
# shared bound: it is not divided by k, and a project's own quota may be
# larger. The server gives it to a 0 or absent max_stored_bytes; cell-admin
# and the issuer publish it explicitly at admit and require it here.
PROJECT_STORED_BYTES_DEFAULT=10737418240
# Dedicated: the project's LiveFeed share is compute-1g.env's own,
# SSE_FEED_TOTAL_BYTES / 2 = 32 MiB, the depth the 1 GiB class certified
# for one project with hundreds of shared feeds (PERF-LIVEFEED §2). It
# cannot be the whole 64 MiB: the release posture refuses a project share
# at or above the total at boot (src/config/validation.rs). ML's dedicated
# arms kept shared-cell.env's 8 MiB, which their loads (long-poll and
# produce, no SSE) never reached.
SSE_FEED_PROJECT_BYTES=33554432
# Dedicated: the project memory line is the shard's unabsorbed-bytes line
# below, 256 MiB, as ML's dedicated arms ran: the one project latches its
# writes only where the shard would refuse every append anyway, and its
# held read pages are bounded by the instance read memory (ADMIT_RSS_SHED_MB
# x 1 MiB / 4 = 125 MiB) alone, which it has no neighbour to share with.
PROJECT_MEMORY_PRESSURE_BYTES=268435456
# The one shard's unabsorbed-bytes line (phase B step 12 on one shard):
# 256 MiB, the binary's default, stated here so cell-admin can hold the
# memory line to it: it refuses a profile where PROJECT_SHARE_K x
# PROJECT_MEMORY_PRESSURE_BYTES exceeds it, here 1 x 256 MiB.
MAX_UNABSORBED_BYTES_PER_SHARD=268435456
# The request-body ceiling on shared cells (same decision): 8 MiB, not the
# 32 MiB protocol pin. A 32 MiB body is about 130 s of a project's append
# ceiling, and eight lone 32 MiB bodies buffered at once would be 256 MiB.
# Larger bodies get 413. The ceiling is stored with the namespace at
# creation, so a cell keeps the value it was created with.
MAX_REQUEST_BODY_BYTES=8388608
# The block caches, sized for the one-shard shared cell (mem lane,
# 2026-10-19), not compute-1g.env's 128 MiB shared cache.
# Writes fill them, not reads: SlateDB inserts every data block of every
# memtable flush (cache-on-write), so under any write load it sits at
# capacity, and the ~23 KB blocks they insert and evict pin about twice
# their size in allocator pages. Under Layer B's compliant load at 128 +
# 32 MiB the cell held 503-541 MB RSS for 283-290 MB of live heap and
# refused appends at the 500 MB shed line from 680 s on; the
# measurement and the sizing model are pinned in src/config/tests.rs
# (the_shared_cells_load_working_set_leaves_room_under_the_shed_line).
# A tail read 2-10 s behind is served from the memtable or the newest L0
# tables, which these sizes still hold.
SHARED_CACHE_BYTES=33554432
# The durable-tail ring of the cell's one shard: 8 MiB (the cost report of
# 2026-10-24, lever 6; its owner decision 2, PENDING). A long-poll or SSE
# wake and a reader near the head take their window from the pages
# published at ack time (src/shard/record.rs, read_window). With the ring
# off they scan the shard log, and the scan's merge reads a block of every
# sorted run from the store, compaction output caching no data block, even
# when the record it wants is in the memtable: a GET per run per woken
# read, pinned by the DST
# reads_ring::the_shared_cell_ring_serves_a_woken_read_without_a_store_get.
# One shard, so this per-engine budget is the cell's whole ring; 8 MiB is
# about 4 s of the cell's append envelope and fits the +40 MB the Q0
# memory bar leaves. src/config/tests.rs counts it in the instance memory
# sums.
TAIL_RING_BYTES=8388608
# S-gap step 2 (the lead's ruling of 2026-10-30, call 11): the sealer seals
# at three quarters of L0_SST_SIZE_BYTES (src/shard/seal.rs,
# memtable_trigger), so a 32 MiB L0 lets one seal window take a 24 MiB
# memtable and 96-128 WAL objects instead of 6 MiB. SlateDB requires
# MAX_UNFLUSHED_BYTES above it. Memory budget line: this cell's one shard
# DB holds up to 64 MiB unflushed against compute-1g's 16 MiB, +48 MiB;
# with the 144 MiB of fixed caches and the boot check's 100 MiB of headroom
# it stays under the 500 MB shed line.
L0_SST_SIZE_BYTES=33554432
MAX_UNFLUSHED_BYTES=67108864
