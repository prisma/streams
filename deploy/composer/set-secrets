#!/usr/bin/env bun
// set-secrets: put a stage's secrets into the platform by name (public-beta
// deploy-q5 triage B5 and D10), the only way a secret reaches a deployed
// cell, issuer or cell watch: Composer's preflight then finds every
// envSecret name set,
// and no secret is ever in the deploy shell's environment, which
// deploy-release.sh refuses.
//
//   PRISMA_TOKEN_FILE=F deploy/composer/set-secrets <stage> --project ID
//     [--branch ID] --from DIR [--app cell|issuer|cell-watch] [--management-api URL]
//   PRISMA_TOKEN_FILE=F deploy/composer/set-secrets scratch --project ID
//     --branch ID --blank NAME [--app cell|issuer|cell-watch] [--management-api URL]
//
// For each envSecret name the app binds (deploy/composer/app.ts for the
// cell, the default; deploy/composer-issuer/app.ts for the issuer;
// deploy/cell-watch/module.ts for the cell watch, into the watch's own
// project), the value is DIR/<NAME>, a regular file only its owner can
// read, without one trailing newline; the cell's values must be
// space-free, as its entry requires, and the watch's ALERT_SINK_URL and
// HEARTBEAT_URL https URLs, as its boot requires of a deployed watch. Every file is read before anything is written. Then
// each name is created, `POST /v1/environment-variables`, in the stage's
// scope: the production class for the default stage (production), the
// named stage's Branch override (class preview, --branch) for scratch and
// cert; a name the scope already holds (409) is replaced by `PATCH
// /v1/environment-variables/{id}`, and the next deploy restarts the
// service with it (Composer folds each name's updatedAt into the deploy,
// D0 finding 8). The Management API token is read from the file
// PRISMA_TOKEN_FILE names. Names are logged; a value never is, and never
// appears on a command line. An empty file is refused.
//
// --blank NAME, on the scratch stage only, writes that one name with an
// empty value instead: the name stays set, so deploy-release.sh's and
// Composer's checks (names only) pass, and the entry refuses the empty
// secret at boot, which is how the missing-secret boot failure is reached
// (lifecycle leg 7; lead decision deploy-q5 #6 (2): no bypass in
// deploy-release.sh). `--from DIR` restores it.
//
// Exit codes: 0 set, 1 refused or failed (names set before a failure stay
// set: run it again), 2 usage.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parseFlags } from "../cell-admin/args";
import { AdminError } from "../cell-admin/errors";
import {
  describeScope,
  envSecretNames,
  inScope,
  MANAGEMENT_API,
  ownerOnlyFile,
  Platform,
  type Scope,
  scopeOf,
  scopeQuery,
} from "./platform";
import { STAGES } from "./streams/env";

const USAGE =
  "usage: PRISMA_TOKEN_FILE=F set-secrets <stage> --project ID [--branch ID] --from DIR [--app cell|issuer|cell-watch] [--management-api URL]\n" +
  "   or: PRISMA_TOKEN_FILE=F set-secrets scratch --project ID --branch ID --blank NAME [--app cell|issuer|cell-watch] [--management-api URL]";
const APPS = { cell: "composer/app.ts", issuer: "composer-issuer/app.ts", "cell-watch": "cell-watch/module.ts" } as const;
/// The watch's secrets its boot (deploy/cell-watch/config.ts) refuses as
/// anything but an https URL once it runs off this machine.
const WATCH_URLS = ["ALERT_SINK_URL", "HEARTBEAT_URL"];

const isHttps = (value: string) => {
  try {
    return new URL(value).protocol === "https:";
  } catch {
    return false;
  }
};

/// Each name's value from DIR/<NAME>, all read before any is written.
function readValues(app: keyof typeof APPS, names: readonly string[], dir: string): Map<string, string> {
  const values = new Map<string, string>();
  for (const name of names) {
    const value = ownerOnlyFile(join(dir, name), "the secret file");
    if (app === "cell" && /\s/.test(value)) {
      throw new AdminError(`the value of ${name} in ${join(dir, name)} is not space-free: the cell's entry refuses it`);
    }
    if (app === "cell-watch" && WATCH_URLS.includes(name) && !isHttps(value)) {
      throw new AdminError(`the value of ${name} in ${join(dir, name)} is not an https URL: the watch's boot refuses it`);
    }
    values.set(name, value);
  }
  return values;
}

/// Create `name` in the scope, or replace the value it holds there.
async function setOne(api: Platform, scope: Scope, name: string, value: string): Promise<"created" | "replaced"> {
  const row = { projectId: scope.project, class: scope.class, key: name, value };
  const created = await api.call(
    "POST",
    "/environment-variables",
    scope.class === "preview" ? { ...row, branchId: scope.branch } : row,
    [409],
  );
  if (created.status !== 409) return "created";
  const rows = (await api.list(`/environment-variables?${scopeQuery(scope)}&key=${encodeURIComponent(name)}`)).filter(
    (r) => r.key === name && inScope(scope, r),
  );
  if (rows.length !== 1) {
    throw new AdminError(`${name} answered 409 in ${describeScope(scope)}, but the listing holds ${rows.length} such variables`);
  }
  await api.call("PATCH", `/environment-variables/${encodeURIComponent(rows[0].id)}`, { value });
  return "replaced";
}

/// --blank: one name of the scratch stage's scope, emptied.
async function blankOne(
  stage: string,
  scope: Scope,
  app: keyof typeof APPS,
  names: readonly string[],
  name: string,
  managementApi: string | undefined,
  out: (line: string) => void,
): Promise<void> {
  if (stage !== "scratch") {
    throw new AdminError(`--blank empties a secret on the scratch stage only (the missing-secret boot failure); ${stage} is not scratch`);
  }
  if (!names.includes(name)) throw new AdminError(`the ${app} binds no ${name}: --blank takes one of its envSecret names`);
  await setOne(Platform.open(managementApi ?? MANAGEMENT_API), scope, name, "");
  out(
    `set-secrets: ${name} blanked in ${describeScope(scope)}: the next deploy boots without it (the entry refuses an empty secret); ` +
      "set it again with --from",
  );
}

export async function main(argv: readonly string[], out: (line: string) => void): Promise<void> {
  const [stage, ...rest] = argv;
  if (!(STAGES as readonly string[]).includes(stage ?? "")) throw new AdminError(`the stage is one of ${STAGES.join(", ")}`, 2);
  const f = parseFlags(rest, {
    single: ["project", "branch", "from", "blank", "app", "management-api"],
    required: ["project"],
  });
  if (f.has("from") === f.has("blank")) throw new AdminError("give --from DIR (every secret) or --blank NAME (one, on scratch only)", 2);
  const app = (f.get("app") ?? "cell") as keyof typeof APPS;
  if (!(app in APPS)) throw new AdminError(`--app ${app} is cell, issuer or cell-watch`, 2);
  const scope = scopeOf(stage, f.must("project"), f.get("branch"));
  const names = envSecretNames(readFileSync(join(import.meta.dir, "..", APPS[app]), "utf8"));
  const blank = f.get("blank");
  if (blank !== undefined) return blankOne(stage, scope, app, names, blank, f.get("management-api"), out);
  const values = readValues(app, names, f.must("from"));
  const api = Platform.open(f.get("management-api") ?? MANAGEMENT_API);
  for (const name of names) {
    const how = await setOne(api, scope, name, values.get(name) as string);
    out(`set-secrets: ${name} ${how} in ${describeScope(scope)}`);
  }
  out(`set-secrets: the ${app}'s ${names.length} secrets are set for ${stage}; deploy to use them`);
}

if (import.meta.main) {
  try {
    await main(process.argv.slice(2), (line) => console.log(line));
  } catch (e) {
    const known = e instanceof AdminError;
    console.error(`set-secrets: ${known ? e.message : `unexpected failure: ${(e as Error).message}`}`);
    if (known && e.code === 2) console.error(USAGE);
    process.exit(known ? e.code : 1);
  }
}
