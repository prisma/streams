{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.io/streams-platform/v1/keys.schema.json",
  "title": "Streams JWKS feed snapshot",
  "type": "object",
  "required": ["feed_version", "keys"],
  "additionalProperties": false,
  "properties": {
    "feed_version": { "type": "integer", "minimum": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kid", "alg", "aud", "pem"],
        "additionalProperties": false,
        "properties": {
          "kid": { "type": "string", "minLength": 1, "maxLength": 128 },
          "alg": { "enum": ["RS256", "EdDSA"] },
          "aud": {
            "description": "The one token audience this key may sign for (MULTITENANCY §14.1 r7): customer access tokens or fleet workload tokens, never both. Fixed for the life of the kid.",
            "enum": ["prisma-streams-data", "prisma-streams-internal"]
          },
          "pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
        }
      }
    }
  }
}
