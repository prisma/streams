{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.io/streams-platform/v1/project-policies.schema.json",
  "title": "Streams project-policy feed snapshot (full, per cell)",
  "type": "object",
  "required": ["feed_version", "projects"],
  "additionalProperties": false,
  "properties": {
    "feed_version": { "type": "integer", "minimum": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id", "workspace_id", "cell_id",
          "project_policy_version", "ownership_version", "status", "quotas"
        ],
        "additionalProperties": false,
        "properties": {
          "project_id": { "$ref": "#/$defs/id" },
          "workspace_id": { "$ref": "#/$defs/id" },
          "cell_id": { "$ref": "#/$defs/id" },
          "project_policy_version": { "type": "integer", "minimum": 1 },
          "ownership_version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "suspended", "transfer_pending", "deleting", "deleted"] },
          "quotas": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requests_per_sec": {
                "type": "integer",
                "minimum": 0,
                "description": "Requests a second, one token each, with a burst of max(requests_per_sec, 50) (MULTITENANCY §17.3 r10). Also the rate of the project's store budget (one second's burst): a served request pays for the registry store work it made, a billed GET or HEAD 1 and a PUT, a listing or a COPY 10, and the project's creates, deletes, seals and catalog listings are refused while that budget is in debt (MULTITENANCY §17.3)."
              },
              "append_bytes_per_sec": { "type": "integer", "minimum": 0 },
              "append_records_per_sec": { "type": "integer", "minimum": 0 },
              "read_bytes_per_sec": { "type": "integer", "minimum": 0 },
              "max_inflight_requests": { "type": "integer", "minimum": 0 },
              "max_live_subscriptions": { "type": "integer", "minimum": 0 },
              "max_streams": { "type": "integer", "minimum": 0 },
              "queued_append_bytes": { "type": "integer", "minimum": 0 },
              "max_stored_bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "Stored bytes the project may own: its live segments' stored page bytes after compression, page headers included (the unit of a stream's usage ownedStoredBytesNow). 0 or absent: the cell's PROJECT_STORED_BYTES_DEFAULT, whose default 0 is no limit (MULTITENANCY §17.3, r9)."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
  }
}
