{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisma.io/streams-platform/v1/credential-grants.schema.json",
  "title": "Streams credential-grant feed snapshot (full, per cell)",
  "type": "object",
  "required": ["feed_version", "credentials"],
  "additionalProperties": false,
  "properties": {
    "feed_version": { "type": "integer", "minimum": 1 },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["credential_id", "project_id", "grant_version", "status", "scopes"],
        "additionalProperties": false,
        "properties": {
          "credential_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "project_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "grant_version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "disabled", "revoked", "expired"] },
          "scopes": { "type": "string", "minLength": 1 },
          "stream_prefixes": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": { "type": "string", "minLength": 1 }
          },
          "expires_at": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
